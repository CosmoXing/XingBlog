---
import type { Post } from '../utils';
import { coverStyle, formatDate, readingMinutes } from '../utils';

export interface Props {
  post: Post;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const dots = [
  { left: '30%', top: '58%' },
  { left: '68%', top: '36%' },
  { left: '74%', top: '70%' },
  { left: '42%', top: '64%' },
  { left: '58%', top: '28%' }
];
const dot = dots[index % dots.length];
---

<a class="post-card" href={`/posts/${post.id}/`}>
  <div class="cover" style={coverStyle(index)}>
    <span class="cover-tag">FIG. {String(index + 1).padStart(2, '0')}</span>
    <span class="star-dot" style={`left:${dot.left};top:${dot.top}`}></span>
  </div>
  <div class="body">
    <h4>{post.data.title}</h4>
    <p>{post.data.description}</p>
    <div class="meta">
      <span>{formatDate(post.data.pubDate).slice(5)}</span>
      <span>{readingMinutes(post)} 分钟</span>
    </div>
  </div>
</a>
