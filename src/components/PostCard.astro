---
import type { Post } from '../utils';
import { coverStyle, formatDate, readingMinutes } from '../utils';

export interface Props {
  post: Post;
  index?: number;
  showCover?: boolean;
}

const { post, index = 0, showCover = true } = Astro.props;
const dots = [
  { left: '30%', top: '58%' },
  { left: '68%', top: '36%' },
  { left: '74%', top: '70%' },
  { left: '42%', top: '64%' },
  { left: '58%', top: '28%' }
];
const dot = dots[index % dots.length];
const cover = showCover || Boolean(post.data.pinned);
const img = post.data.cover;
---

<a class:list={['post-card', { 'post-card--text': !cover }]} href={`/posts/${post.id}/`}>
  {
    cover && (
      <div class:list={['cover', { 'cover--img': Boolean(img) }]} style={img ? undefined : coverStyle(index)}>
        {img ? (
          <>
            <img class="cover-img" src={img} alt={post.data.title} loading="lazy" />
            <span class="cover-shade" />
          </>
        ) : (
          <span class="star-dot" style={`left:${dot.left};top:${dot.top}`} />
        )}
        <span class="cover-tag">FIG. {String(index + 1).padStart(2, '0')}</span>
      </div>
    )
  }
  <div class="body">
    <h4>
      <span class="title-text">
        {post.data.title}
        {post.data.pinned && <span class="pin-star" title="置顶">★</span>}
      </span>
      <span class="pc-arrow">→</span>
    </h4>
    <div class="card-tags">
      <span class="cat">{post.data.category}</span>
      {post.data.tags.slice(0, 2).map((tag) => <span class="tg">#{tag}</span>)}
    </div>
    <p>{post.data.description}</p>
    <div class="meta">
      <span>{formatDate(post.data.pubDate).slice(5)}</span>
      <span>{readingMinutes(post)} 分钟</span>
    </div>
  </div>
</a>
