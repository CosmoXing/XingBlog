---
import '../styles/global.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import { SITE } from '../consts';

export interface Props {
  title?: string;
  description?: string;
  active?: string;
  hideMusicMobile?: boolean;
}

const {
  title,
  description = SITE.description,
  active = '',
  hideMusicMobile = false
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.subtitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05070C" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      try {
        var saved = localStorage.getItem('cx-theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <canvas id="stars" aria-hidden="true"></canvas>
    <Header active={active} />
    <slot />
    <Footer />
    <MusicPlayer hideOnMobile={hideMusicMobile} />
    <SearchOverlay />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
