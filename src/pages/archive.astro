---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { categoryCounts, formatDate, groupByYear, sortPosts } from '../utils';

const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
const groups = groupByYear(posts);
const counts = categoryCounts(posts);
---

<Layout title="归档" description="按时间排列的全部文章。" active="archive" hideMusicMobile>
  <main class="page-main">
    <header class="page-head">
      <div class="eyebrow">Archive</div>
      <h1>归档<span class="count">{posts.length} POSTS</span></h1>
      <p>按时间排列的全部文章。用分类筛选，或者直接往下翻。</p>
    </header>

    <div class="archive-bar">
      <button class="filter-btn active" type="button" data-archive-filter="all">
        全部 <span class="n">{posts.length}</span>
      </button>
      {
        counts.map((cat) => (
          <button class="filter-btn" type="button" data-archive-filter={cat.name}>
            {cat.name} <span class="n">{String(cat.count).padStart(2, '0')}</span>
          </button>
        ))
      }
    </div>

    {
      groups.map((group) => (
        <section class="archive-group">
          <div class="archive-year">
            {group.year}
            <span>{group.posts.length} 篇</span>
          </div>
          <div class="rows">
            {group.posts.map((post) => (
              <a
                class="row archive-item"
                href={`/posts/${post.id}/`}
                data-category={post.data.category}
              >
                <span class="date">{formatDate(post.data.pubDate)}</span>
                <h4>{post.data.title}</h4>
                <span class="cat-label">{post.data.category}</span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </main>
</Layout>
